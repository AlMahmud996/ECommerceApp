@model List<ECommerceApp.Models.CartItem>

<h2>Your Shopping Cart</h2>

@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>
    <a href="/Products">Continue Shopping</a>
}
else
{
    <table style="width:100%; border-collapse:collapse;">
        <tr style="background:#f5f5f5;">
            <th style="padding:10px; text-align:left;">Product</th>
            <th style="padding:10px;">Price</th>
            <th style="padding:10px;">Quantity</th>
            <th style="padding:10px;">Total</th>
            <th style="padding:10px;">Action</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr style="border-bottom:1px solid #ddd;">
                <td style="padding:10px;">@item.Product.Name</td>
                <td style="padding:10px; text-align:center;">$@item.Product.Price</td>
                <td style="padding:10px; text-align:center;">@item.Quantity</td>
                <td style="padding:10px; text-align:center;">$@(item.Product.Price * item.Quantity)</td>
                <td style="padding:10px; text-align:center;">
                    <a href="/Cart/Remove/@item.Id" style="color:red;">Remove</a>
                </td>
            </tr>
        }
    </table>

    <h3 style="margin-top:20px;">
        Total: $@Model.Sum(i => i.Product.Price * i.Quantity)
    </h3>

    <br/>
    <a href="/Products">Continue Shopping</a>
    <br/>
<a href="/Order/Checkout" style="display:inline-block; padding:10px 24px; background:#28a745; color:white; border-radius:6px; text-decoration:none;">
    Proceed to Checkout
</a>
}
